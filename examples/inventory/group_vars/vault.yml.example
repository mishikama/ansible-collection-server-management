---
# Template for secrets. Copy to vault.yml and encrypt it:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# Editing:        ansible-vault edit inventory/group_vars/vault.yml
# Running playbooks: ansible-playbook ... --ask-vault-pass
#                 or --vault-password-file ~/.vault_pass.txt

vault_deploy_user_password_hash: "$6$rounds=656000$..."   # generate with: mkpasswd -m sha-512

# Read-only SSH deploy key for the Flux git repo (roles/flux_operator),
# used when flux_operator_git_auth_type: ssh (the default). Generate a
# dedicated key and add its public half as a read-only deploy key on the
# repo. The host's known_hosts entry is fetched automatically via
# ssh-keyscan when the role runs, so it doesn't need to go here.
vault_flux_git_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  ...
  -----END OPENSSH PRIVATE KEY-----

# HTTPS token for the Flux git repo (roles/flux_operator), used when
# flux_operator_git_auth_type: https instead. E.g. a GitHub fine-grained
# personal access token scoped to "Contents: Read-only" on just that repo.
vault_flux_git_https_token: "github_pat_..."

# age private key for Flux's SOPS decryption (roles/flux_operator), used to
# decrypt SOPS-encrypted secrets committed in the synced git repo. Generate
# with: age-keygen -o age.agekey. Leave flux_operator_sops_age_key unset in
# group_vars to skip creating this secret if you don't use SOPS.
vault_flux_sops_age_key: |
  AGE-SECRET-KEY-...
